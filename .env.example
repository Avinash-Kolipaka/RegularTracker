# RegulaTrack Environment Variables

# Django Application
DJANGO_SECRET_KEY=django-insecure-regulatrack-dev-key-change-in-production-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,web

# Database Configuration (Defaults to SQLite for local dev, or set postgres)
DB_ENGINE=sqlite
DB_NAME=regulatrack_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Celery & Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Media and Upload Storage
MEDIA_ROOT=media/
MAX_UPLOAD_SIZE_BYTES=26214400 # 25MB
