# Django Configuration
DEBUG=True
SECRET_KEY=django-insecure-regulatrack-dev-key-change-in-production-!$94%^#@
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database Configuration
# Leave DB_ENGINE empty or set to 'sqlite' for zero-config local development
# Set DB_ENGINE=postgres and supply credentials for production PostgreSQL
DB_ENGINE=sqlite
DB_NAME=regulatrack.db
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Media and Uploads
MEDIA_ROOT=media
MEDIA_URL=/media/

# JWT Authentication
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# Email backend (console for development, smtp for production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
